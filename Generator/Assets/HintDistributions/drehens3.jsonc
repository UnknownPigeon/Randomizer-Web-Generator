{
  "starting": {
    "spot": "midna",
    "excludeFromGroups": true
  },
  "agitha": true,
  "jovani": {
    "minFoundSoulsForHint": 0
  },
  "caveOfOrdeals": true,
  "dungeons": {
    "bigKeyHints": true
  },
  "beyondPointZones": ["Lake_Lantern_Cave", "Snowpeak_Mountain", "Goron_Mines", "Lakebed_Temple", "Arbiters_Grounds", "Temple_of_Time", "City_in_the_Sky"],
  "barren": {
    "monopolizeSpots": true,
    "ownZoneShowsAsJunkHint": false
  },
  "always": {
    "monopolizeSpots": true,
    "idealNumSpots": 6,
    "copies": 3,
    "groupId": "overworld"
  },
