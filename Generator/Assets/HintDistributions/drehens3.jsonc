    "Skybook From Impaz": ["always"]
  },
  "removeChecks": {
    "Plumm Fruit Balloon Minigame": ["always"],
    "Goron Springwater Rush": ["always"],
    "PoT Collect Both Sols": ["always"],
    "ZD Extinguish All Torches Chest": ["sometimes"],
    "ZD Light All Torches Chest": ["sometimes"],
    "Eldin Spring Underwater Chest": ["sometimes"],
    "Lake Hylia Underwater Chest": ["sometimes"],
    "AG Death Sword Chest": ["sometimes"],
    "FT Gale Boomerang": ["sometimes"],
    "CitS Aeralfos Chest": ["sometimes"]
  },
  "removeItems": {
  },
  //
  "groups": {
    "overworld": ["alias:overworldZones"],
    "requiredDungeons": ["alias:requiredDungeons"]
  },
  "specialHintDefs": [
    {
      "spot": "death_mountain_sign",
      "hintDef": {
        "hintType": "location",
        "options": {
          "canBeClaimHinted": true,
          "vague": true,
          "validChecks": ["Death Mountain Alcove Chest"]
        }
      }
    },
    {
      "spot": "forest_temple_sign",
      "hintDef": {
        "hintType": "location",
        "options": {
          "canBeClaimHinted": true,
          "validChecks": ["FT Gale Boomerang"]
        }
      }
    },
    {
      "spot": "snowpeak_ruins_sign",
      "hintDef": {
        "maxPicks": 1,
        "hintDef": [
          {
            "hintType": "location",
            "options": {
              "canBeClaimHinted": true,
              "validChecks": [
                "SPR Chapel Chest",
                "SPR Lobby Chandelier Chest",
                "SPR Northeast Chandelier Chest"
              ],
              "validItems": ["Snowpeak_Ruins_Bedroom_Key"]
            }
          },
          {
            "hintType": "location",
            "options": {
              "canBeClaimHinted": true,
              "validChecks": [
                "SPR Chapel Chest",
                "SPR Lobby Chandelier Chest",
                "SPR Northeast Chandelier Chest"
              ]
            }
          }
        ]
      }
    },
    {
      "spot": "temple_of_time_sign",
      "hintDef": {
        "hintType": "location",
        "options": {
          "canBeClaimHinted": true,
          "checkStatusDisplay": "required_info",
          "validChecks": ["ToT Lobby Lantern Chest"]
        }
      }
    },
    {
      "spot": "palace_of_twilight_sign",
      "hintDef": {
        "hintType": "location",
        "options": {
          "canBeClaimHinted": true,
          "checkStatusDisplay": "required_info",
